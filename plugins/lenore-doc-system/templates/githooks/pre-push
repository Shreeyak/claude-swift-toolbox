#!/usr/bin/env bash
# Lenore doc system — pre-push
# Landing gate: rejects a push updating refs/heads/main unless the landing
# markers hold (no docs/tasks/branch-*.md, no unarchived openspec changes).
#
# Escape hatch (not documented to agents): LAND_SKIP=1 git push ...
set -euo pipefail

if [ "${LAND_SKIP:-0}" = "1" ]; then
  exit 0
fi

remote="$1"
url="$2"

updating_main=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  if [ "$remote_ref" = "refs/heads/main" ] || [ "$remote_ref" = "refs/heads/master" ]; then
    updating_main=1
    push_sha="$local_sha"
  fi
done

if [ "$updating_main" -ne 1 ]; then
  exit 0
fi

fail=0

# No docs/tasks/branch-*.md should exist in the tree being pushed to main.
branch_files=$(git ls-tree -r --name-only "$push_sha" -- 'docs/tasks' 2>/dev/null | grep -E '^docs/tasks/branch-.*\.md$' || true)
if [ -n "$branch_files" ]; then
  echo "error: pre-push (landing gate): unarchived branch task file(s) in the tree being merged" >&2
  echo "$branch_files" | sed 's/^/  /' >&2
  echo "  the landing flow deletes docs/tasks/branch-*.md after graduating survivors to" >&2
  echo "  docs/tasks/project.md with your confirmation. run /lenore-doc-system:land and retry." >&2
  fail=1
fi

# No non-empty openspec/changes/*/ folders (skip gracefully if openspec absent).
if git ls-tree -d "$push_sha" -- openspec >/dev/null 2>&1; then
  change_dirs=$(git ls-tree -d --name-only "$push_sha" -- 'openspec/changes' 2>/dev/null || true)
  if [ -n "$change_dirs" ]; then
    while IFS= read -r d; do
      [ -z "$d" ] && continue
      contents=$(git ls-tree -r --name-only "$push_sha" -- "$d" 2>/dev/null || true)
      if [ -n "$contents" ]; then
        echo "error: pre-push (landing gate): unarchived openspec change folder: $d" >&2
        fail=1
      fi
    done <<< "$change_dirs"
    if [ "$fail" -ne 0 ]; then
      echo "  in-flight openspec/changes/ must be archived before landing." >&2
      echo "  run /lenore-doc-system:land and retry." >&2
    fi
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "pre-push rejected: main requires a completed landing flow." >&2
  echo "run /lenore-doc-system:land, or LAND_SKIP=1 git push (misfires only)." >&2
  exit 1
fi

exit 0
