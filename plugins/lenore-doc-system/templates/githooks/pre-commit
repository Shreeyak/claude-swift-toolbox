#!/usr/bin/env bash
# Lenore doc system — pre-commit
# Enforces: (1) immutability of docs/journal, docs/notes, experiments/*/notebook
#           (2) deny-filename for tracking docs (state.md, decisions.md, ...)
#           (3) closed docs/ layout + extension rules + 5MB size cap:
#               top-level docs/ children are a fixed set (spine files + known
#               dirs); prose everywhere, figures + diagram sources
#               (.d2/.excalidraw/.mmd/.py) beside spine chapters and inside
#               dated note bundles, data evidence (.csv/.json) only inside
#               bundles; note bundles are dated dirs with an index.md
#           (4) no symlinks/gitlinks under docs/ or experiments/ (except
#               AGENTS.md and each experiment's data -> ../../data/... symlink)
#           (5) shape of new journal/notes/bugs .md files (caps, line-1 summary)
#               and of new notebook entries (runNNN name, outcome sentence)
#           (6) experiment conclusion gate: flipping status to concluded/shelved
#               requires a verdict, a concluded date, and a journal entry in the
#               same commit
#           (7) experiment isolation: no import-shaped references to experiments/
#               from code outside experiments/, and no symlinks targeting it
#           (8) merge guidance for conflicting dated notes/bugs: both versions
#               should survive (one refiled under a new dated name); a repeated
#               identical attempt proceeds — deliberate drops are allowed
#           (9) judgment lint at the git layer — for users whose commits are
#               NOT made through an agent harness with hooks (manual commits,
#               other harnesses, CI). Persistent toggle: `git config
#               lenore.commitlint true`; LENORE_COMMIT_LINT=1/0 overrides per
#               command. Commits already vetted by a harness hook skip (the
#               ok-hash handshake), so enabling this never double-judges.
#           (10) experiment rename warning (informational, never blocks):
#               renaming experiments/<a>/ prints a reminder to also move
#               the store dir data/experiments/<a>.
#           (11) experiments/PROMOTIONS.md is append-only: modifications must
#               keep the old content as a prefix; deletion is blocked.
#           (12) proposal shape: every staged docs/proposals/*.md carries a
#               front-matter status: proposed|accepted|deferred|superseded|
#               implemented (proposals are the one revisable dated class —
#               the status field is what makes that safe).
set -euo pipefail

[ "${SKIP_DOC_HOOKS:-0}" = "1" ] && exit 0

if git rev-parse --verify -q HEAD >/dev/null; then
  AGAINST=HEAD
else
  AGAINST=$(git hash-object -t tree /dev/null)
fi

fail=0

MERGE_HEAD_REF=""
MERGE_BASE=""
if git rev-parse --verify -q MERGE_HEAD >/dev/null 2>&1; then
  MERGE_HEAD_REF=MERGE_HEAD
  MERGE_BASE=$(git merge-base HEAD MERGE_HEAD 2>/dev/null || true)
fi

# Parse the staged diff with -z so renames/copies and odd filenames are safe.
# --name-status -z -M: records are NUL-separated; R/C records carry an extra
# similarity/src/dst triple.
immutable_modified=""
immutable_deleted=""
added=""
denied_names='^(state|decisions|status|changelog|handoff(-.+)?|plan(-.+)?|review(-.+)?)\.md$'

# experiments/<one segment>/notebook/<one segment>.md (also legacy runs/).
# Bash case-glob * crosses /, so parse components explicitly — a nested
# experiments/foo/src/notebook/x.md is ordinary experiment code, not an entry.
is_notebook_entry() {
  ne_rest=${1#experiments/}
  [ "$ne_rest" = "$1" ] && return 1
  ne_exp=${ne_rest%%/*}
  ne_sub=${ne_rest#*/}
  [ -z "$ne_exp" ] && return 1
  [ "$ne_sub" = "$ne_rest" ] && return 1
  case "$ne_sub" in
    notebook/*.md) ne_file=${ne_sub#notebook/} ;;
    runs/*.md)     ne_file=${ne_sub#runs/} ;;
    *) return 1 ;;
  esac
  case "$ne_file" in */*) return 1 ;; esac
  return 0
}

is_immutable_path() {
  lc=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  case "$lc" in
    docs/journal/*|docs/notes/*) return 0 ;;
  esac
  is_notebook_entry "$lc"
}

while IFS= read -r -d '' status; do
  case "$status" in
    R*|C*)
      IFS= read -r -d '' src
      IFS= read -r -d '' dst
      if is_immutable_path "$src"; then
        immutable_modified="${immutable_modified}${src} (renamed/copied away)"$'\n'
      fi
      f="$dst"
      # dst is treated like an addition for filename/prose checks below.
      added="${added}${f}"$'\n'
      ;;
    M)
      IFS= read -r -d '' f
      if is_immutable_path "$f"; then
        # During a merge commit, resolving an add/add conflict to the OTHER
        # branch's committed version is not a rewrite — both blobs were
        # committed immutably on their own branches. Check (8) ensures the
        # losing version survives under a new name. Only a true add/add
        # qualifies: if the file already existed at the merge base, taking
        # the incoming blob IS a rewrite of committed history.
        if [ -n "$MERGE_HEAD_REF" ]; then
          staged_blob=$(git rev-parse -q --verify ":$f" 2>/dev/null || true)
          theirs_blob=$(git rev-parse -q --verify "$MERGE_HEAD_REF:$f" 2>/dev/null || true)
          base_blob=""
          [ -n "$MERGE_BASE" ] && base_blob=$(git rev-parse -q --verify "$MERGE_BASE:$f" 2>/dev/null || true)
          if [ -z "$base_blob" ] && [ -n "$staged_blob" ] && [ "$staged_blob" = "$theirs_blob" ]; then
            :
          else
            immutable_modified="${immutable_modified}${f}"$'\n'
          fi
        else
          immutable_modified="${immutable_modified}${f}"$'\n'
        fi
      fi
      ;;
    D)
      IFS= read -r -d '' f
      # Case-folded like adds/modifies, so NOTEBOOK/ can't dodge the check.
      # docs/notes stays deletable; journal and notebook entries do not.
      lc_d=$(printf '%s' "$f" | tr '[:upper:]' '[:lower:]')
      if { case "$lc_d" in docs/journal/*) true ;; *) false ;; esac; } || is_notebook_entry "$lc_d"; then
        immutable_deleted="${immutable_deleted}${f}"$'\n'
      fi
      ;;
    A)
      IFS= read -r -d '' f
      added="${added}${f}"$'\n'
      ;;
    *)
      # T (typechange) and any other single-path status: consume one path.
      IFS= read -r -d '' f || true
      ;;
  esac
done < <(git diff --cached --name-status -z -M "$AGAINST" 2>/dev/null || true)

# --- (1) Immutability -------------------------------------------------
if [ -n "$immutable_modified" ]; then
  echo "error: pre-commit (immutability): the following files are immutable once committed" >&2
  printf '%s' "$immutable_modified" | sed '/^$/d;s/^/  modified: /' >&2
  echo "  journal entries, notes, and experiment notebook entries may not be edited or renamed after commit." >&2
  echo "  fix typos before the first commit, or write a new dated file instead." >&2
  fail=1
fi

if [ -n "$immutable_deleted" ]; then
  echo "error: pre-commit (immutability): journal entries and notebook entries may not be deleted" >&2
  printf '%s' "$immutable_deleted" | sed '/^$/d;s/^/  deleted: /' >&2
  echo "  these are history and evidence. notes/ may be deleted; these may not." >&2
  fail=1
fi

# --- (2) Deny tracking-doc filenames -----------------------------------
if [ -n "$added" ]; then
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    base=$(basename "$f")
    lower=$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')
    if printf '%s' "$lower" | grep -qE "$denied_names"; then
      echo "error: pre-commit (deny-filename): $f is a disallowed tracking-doc filename" >&2
      echo "  state.md/decisions.md/STATUS.md/CHANGELOG.md/HANDOFF.md are not part of this" >&2
      echo "  doc system. decisions-as-history -> docs/journal/; decisions-as-current-truth" >&2
      echo "  -> openspec/specs/ or CLAUDE.md; status -> docs/tasks/ + the status line." >&2
      fail=1
    fi
  done <<< "$added"
fi

# --- (3) Closed docs/ layout, extension rules, size cap -------------------
# docs/ is a closed set. Extensions vary by area: prose everywhere; figures
# and their editable sources beside spine chapters and inside note bundles;
# small data evidence only inside bundles. Big bytes go to the store.
DOCS_MAX_BYTES=5242880
ext_err() {  # ext_err <file> <allowed-description>
  echo "error: pre-commit (docs layout): $1 has a disallowed extension here" >&2
  echo "  $2" >&2
  echo "  code -> scripts/ or experiments/<name>/ ; run outputs -> data/experiments/<name>/out/ ;" >&2
  echo "  large/binary evidence -> the gitignored store (data/) ; throwaway -> tmp/." >&2
  fail=1
}
if [ -n "$added" ]; then
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    lower_f=$(printf '%s' "$f" | tr '[:upper:]' '[:lower:]')
    base=$(basename "$f")
    [ "$base" = ".gitkeep" ] && continue
    # Size cap for docs/ and experiments/ — git is for prose, code, and
    # curated figures; heavyweight bytes live in the store.
    case "$lower_f" in
      docs/*|experiments/*)
        blob_size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
        if [ "$blob_size" -gt "$DOCS_MAX_BYTES" ]; then
          echo "error: pre-commit (size cap): $f is $((blob_size / 1048576))MB — max 5MB under docs/ and experiments/" >&2
          echo "  put the bytes in the gitignored store (data/...) and commit a pointer or a downscaled figure." >&2
          fail=1
          continue
        fi
        ;;
    esac
    case "$lower_f" in docs/*) ;; *) continue ;; esac
    rest=${lower_f#docs/}
    rest_orig=${f#*/}   # original case, for git index lookups
    ext=$(printf '%s' "$lower_f" | sed -n 's/.*\.\([a-z0-9]*\)$/\1/p')
    if [ "$rest" = "${rest%%/*}" ]; then
      # A file directly under docs/ — only the hub files live here.
      case "$rest" in
        claude.md|agents.md|system.md|caveats.md|playbook.md) ;;
        *)
          echo "error: pre-commit (closed layout): docs/$rest_orig is not part of the docs/ layout" >&2
          echo "  docs/ top level is a closed set: CLAUDE.md, system.md, caveats.md, playbook.md, plus" >&2
          echo "  the dirs system/ caveats/ playbook/ proposals/ notes/ journal/ bugs/ tasks/ desk/." >&2
          echo "  Route by question: how it works now -> system; where it fails -> caveats; procedures/" >&2
          echo "  tools/adopted research -> playbook; designed-not-committed -> proposals/; dated" >&2
          echo "  evidence/thinking -> notes/; unsure -> notes/." >&2
          fail=1
          ;;
      esac
      continue
    fi
    seg1=${rest%%/*}
    case "$seg1" in
      system|caveats|playbook)
        case "$ext" in
          md|html|png|jpg|jpeg|gif|svg|webp|d2|excalidraw|mmd|py) ;;
          *) ext_err "$f" "spine chapter dirs hold prose, figures, and the figures' editable sources (.md .html images .d2 .excalidraw .mmd .py)." ;;
        esac
        ;;
      proposals)
        case "$rest" in
          proposals/*/*)
            echo "error: pre-commit (proposals): $f — docs/proposals/ is flat (dated .md files, no subdirs)" >&2
            fail=1
            continue
            ;;
        esac
        if ! printf '%s' "$base" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*\.md$'; then
          echo "error: pre-commit (proposals): $f — proposals are dated files named YYYY-MM-DD-topic.md" >&2
          fail=1
        fi
        ;;
      notes)
        sub=${rest#notes/}
        case "$sub" in
          */*)
            bundle=${sub%%/*}
            bundle_orig=${rest_orig#notes/}; bundle_orig=${bundle_orig%%/*}
            if ! printf '%s' "$bundle" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]'; then
              echo "error: pre-commit (note bundles): $f — a directory under docs/notes/ must be a dated" >&2
              echo "  bundle named YYYY-MM-DD-<topic>/ (multi-file research/evidence efforts only)." >&2
              fail=1
              continue
            fi
            if ! git ls-files --cached -- "docs/notes/$bundle_orig/index.md" 2>/dev/null | grep -q . \
               && ! git ls-files --cached -- "docs/notes/$bundle_orig/INDEX.md" 2>/dev/null | grep -q .; then
              echo "error: pre-commit (note bundles): docs/notes/$bundle_orig/ has no index.md" >&2
              echo "  every bundle carries an index.md: line 1 = one-sentence summary, then what each" >&2
              echo "  member file is and where it came from. Stage it in this commit." >&2
              fail=1
            fi
            case "$ext" in
              md|html|png|jpg|jpeg|gif|svg|webp|d2|excalidraw|mmd|py|csv|json) ;;
              *) ext_err "$f" "bundle members are prose, figures, figure sources, or small data evidence (.md .html images .d2 .excalidraw .mmd .py .csv .json)." ;;
            esac
            ;;
          *)
            case "$ext" in
              md|html) ;;
              *) ext_err "$f" "single notes are .md or .html; figures/sources/data ride in a dated bundle dir (docs/notes/YYYY-MM-DD-topic/)." ;;
            esac
            ;;
        esac
        ;;
      journal|bugs|tasks)
        case "$ext" in
          md) ;;
          *) ext_err "$f" "docs/$seg1/ holds .md files only." ;;
        esac
        ;;
      desk) ;;   # gitignored; nothing staged here is ours to shape
      reference)
        echo "error: pre-commit (closed layout): docs/reference/ is retired" >&2
        echo "  external-tool how-tos and procedures -> docs/playbook.md; internal explanations" >&2
        echo "  -> docs/system/ chapters; dated research -> docs/notes/." >&2
        fail=1
        ;;
      *)
        echo "error: pre-commit (closed layout): docs/$seg1/ is not a known docs/ directory" >&2
        echo "  the set is closed: system/ caveats/ playbook/ proposals/ notes/ journal/ bugs/ tasks/ desk/." >&2
        echo "  New homes are a design change, not a filing decision — when unsure, file a dated note." >&2
        fail=1
        ;;
    esac
  done <<< "$added"
fi

# --- (4) No symlinks/gitlinks under docs/ or experiments/ (except AGENTS.md) --
while IFS= read -r -d '' rec; do
  case "$rec" in
    :*)
      # format: :old_mode new_mode old_sha new_sha status
      new_mode=$(printf '%s' "$rec" | awk '{print $2}')
      status=$(printf '%s' "$rec" | awk '{print $5}')
      ;;
    *)
      continue
      ;;
  esac
  case "$status" in
    R*|C*)
      IFS= read -r -d '' src
      IFS= read -r -d '' dst
      path="$dst"
      ;;
    *)
      IFS= read -r -d '' path
      ;;
  esac
  case "$path" in
    docs/*|experiments/*) ;;
    *) continue ;;
  esac
  if [ "$new_mode" = "120000" ] || [ "$new_mode" = "160000" ]; then
    base=$(basename "$path")
    if [ "$new_mode" = "120000" ] && [ "$base" = "AGENTS.md" ]; then
      continue
    fi
    # The one blessed experiment symlink: experiments/<exp>/data pointing at
    # exactly its own store dir, ../../data/experiments/<exp>. Anything else
    # stays banned: prefix-only matching would accept traversal
    # (../../data/../../src) or another experiment's store.
    if [ "$new_mode" = "120000" ] && [ "$base" = "data" ]; then
      expseg=${path#experiments/}
      expseg=${expseg%/data}
      if [ "$path" = "experiments/$expseg/data" ]; then
        case "$expseg" in
          ""|*/*) ;;   # nested or empty — not the blessed location
          *)
            target=$(git show ":$path" 2>/dev/null || true)
            if [ "$target" = "../../data/experiments/$expseg" ]; then
              continue
            fi
            echo "error: pre-commit (data symlink): $path -> $target" >&2
            echo "  the target must be exactly ../../data/experiments/$expseg (its own store dir)." >&2
            fail=1
            continue
            ;;
        esac
      fi
    fi
    echo "error: pre-commit (no symlinks/gitlinks): $path (mode $new_mode) may not be added under docs/ or experiments/" >&2
    fail=1
  fi
done < <(git diff --cached --raw -z -M "$AGAINST" 2>/dev/null || true)

# --- (5) Shape of new journal/notes/bugs entries -------------------------
# Checks the STAGED content (git show :path), not the worktree.
if [ -n "$added" ]; then
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    lower_f=$(printf '%s' "$f" | tr '[:upper:]' '[:lower:]')
    # Inside a note bundle, only index.md carries the line-1 summary; other
    # members are arbitrary evidence (external agents' reports, data, figures).
    case "$lower_f" in
      docs/notes/*/*)
        case "$(basename "$lower_f")" in index.md) ;; *) continue ;; esac
        ;;
    esac
    case "$lower_f" in
      docs/journal/*.md|docs/notes/*.md|docs/notes/*/index.md|docs/bugs/*.md) ;;
      *)
        is_notebook_entry "$lower_f" || continue
        # Notebook entries: runNNN[-slug].md; `# runNNN[-slug] — date` header
        # naming its own file; the first line below the header is a
        # one-sentence outcome summary; the numeric id is unique per
        # experiment.
        base=$(basename "$f")
        if ! printf '%s' "$base" | grep -qE '^run[0-9]{3,}(-[a-z0-9][a-z0-9-]*)?\.md$'; then
          echo "error: pre-commit (shape): $f — every .md in notebook/ is a run entry named runNNN[-slug].md" >&2
          echo "  (zero-padded global per-experiment counter; freeform notes go to docs/notes/)." >&2
          fail=1
          continue
        fi
        stem=${base%.md}
        num=$(printf '%s' "$stem" | grep -oE '^run[0-9]+')
        content=$(git show ":$f" 2>/dev/null) || continue
        first=$(printf '%s\n' "$content" | head -1)
        case "$first" in
          "# $stem"|"# $stem "*) ;;
          *)
            echo "error: pre-commit (shape): $f — line 1 must be '# $stem — YYYY-MM-DD'" >&2
            echo "  (the header names its own file; a mismatched id breaks the store join)." >&2
            fail=1 ;;
        esac
        summary=$(printf '%s\n' "$content" | awk 'NR>=2 && NF {print; exit}')
        case "$summary" in
          ""|"#"*|"-"*|"*"*|command:*|commit:*|inputs:*|outputs:*)
            echo "error: pre-commit (shape): $f — the first line under the header must be a one-sentence" >&2
            echo "  outcome summary (what this run established), before the command:/commit:/... anchors." >&2
            fail=1 ;;
        esac
        # Duplicate numeric id: run001-alpha.md next to run001-beta.md breaks
        # the one-number-one-run join. Scan the staged index (covers both
        # existing entries and sibling adds in this commit).
        expdir=${f%/notebook/*}
        expdir=${expdir%/runs/*}
        if [ "$expdir" != "$f" ] && [ -n "$num" ]; then
          dup=$(git ls-files -- "$expdir/notebook" "$expdir/runs" 2>/dev/null | while IFS= read -r other; do
            [ "$other" = "$f" ] && continue
            ostem=$(basename "$other"); ostem=${ostem%.md}
            onum=$(printf '%s' "$ostem" | grep -oE '^run[0-9]+' || true)
            [ -n "$onum" ] || continue
            # numeric compare, so run001 and run0001 still collide
            [ "$((10#${onum#run}))" -eq "$((10#${num#run}))" ] && printf '%s\n' "$other"
          done)
          if [ -n "$dup" ]; then
            echo "error: pre-commit (shape): $f reuses run id $num already taken by:" >&2
            printf '%s\n' "$dup" | sed 's/^/  /' >&2
            echo "  each numeric id is one run; reserve the next id (scripts/lenore-docs.py run)." >&2
            fail=1
          fi
        fi
        continue
        ;;
    esac
    content=$(git show ":$f" 2>/dev/null) || continue

    # Line 1 must be a prose summary sentence, not empty and not a heading.
    first=$(printf '%s\n' "$content" | head -1)
    case "$first" in
      "" )
        echo "error: pre-commit (shape): $f — line 1 is empty; it must be a one-sentence summary" >&2
        echo "  (that line is what listings and search results show)." >&2
        fail=1 ;;
      "#"* )
        echo "error: pre-commit (shape): $f — line 1 is a heading; it must be a plain one-sentence summary" >&2
        echo "  (that line is what listings and search results show; drop the leading #)." >&2
        fail=1 ;;
    esac

    # Journal entries additionally: <=10 non-blank lines, <=150 words, no headers/bullets.
    case "$lower_f" in
      docs/journal/*.md)
        nlines=$(printf '%s\n' "$content" | grep -c -v '^[[:space:]]*$' || true)
        nwords=$(printf '%s\n' "$content" | wc -w | tr -d ' ')
        listy=$(printf '%s\n' "$content" | grep -c -E '^[[:space:]]*(#|-[[:space:]]|\*[[:space:]])' || true)
        shape_problems=""
        [ "$nlines" -gt 10 ] && shape_problems="${shape_problems}  ${nlines} non-blank lines (max 10)"$'\n'
        [ "$nwords" -gt 150 ] && shape_problems="${shape_problems}  ${nwords} words (max 150)"$'\n'
        [ "$listy" -gt 0 ] && shape_problems="${shape_problems}  ${listy} heading/bullet line(s) (journal entries are plain prose)"$'\n'
        if [ -n "$shape_problems" ]; then
          echo "error: pre-commit (shape): $f breaks the journal shape rules:" >&2
          printf '%s' "$shape_problems" >&2
          echo "  the journal records the arc, not the detail — trim, or move detail to a" >&2
          echo "  dated note. scripts/lenore-docs.py journal enforces this at write time." >&2
          fail=1
        fi
        ;;
    esac
  done <<< "$added"
fi

# --- (6) Experiment conclusion gate --------------------------------------
# When a commit flips an experiment README's status to concluded/shelved,
# the same commit must carry the verdict, the concluded date, and a journal
# entry restating the outcome — this is exactly the update agents forget.
fm_field() {  # fm_field <content> <key> -> value (front-matter only)
  printf '%s\n' "$1" | sed -n '/^---$/,/^---$/p' | sed -n "s/^$2:[[:space:]]*//p" | head -1
}
exp_readmes=$(git diff --cached --name-only -M "$AGAINST" -- 'experiments/*/README.md' 2>/dev/null || true)
if [ -n "$exp_readmes" ]; then
  new_journal=$(printf '%s' "$added" | grep -c '^docs/journal/.*\.md$' || true)
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    staged=$(git show ":$f" 2>/dev/null) || continue
    new_status=$(fm_field "$staged" status | tr '[:upper:]' '[:lower:]')
    # question experiments conclude as concluded/shelved; candidate systems
    # (kind: candidate-system) as adopted/retired. parked is a light flip —
    # no gate. All four terminal states need verdict + date + journal entry.
    case "$new_status" in concluded|shelved|adopted|retired) ;; *) continue ;; esac
    old_content=$(git show "$AGAINST:$f" 2>/dev/null || true)
    old_status=$(fm_field "$old_content" status | tr '[:upper:]' '[:lower:]')
    [ "$old_status" = "$new_status" ] && continue   # not flipped in this commit
    problems=""
    verdict=$(fm_field "$staged" verdict)
    case "$verdict" in
      ""|*"<"*) problems="${problems}  verdict: is empty or still a placeholder — one real sentence stating the outcome"$'\n' ;;
    esac
    concluded=$(fm_field "$staged" concluded)
    [ -z "$concluded" ] && problems="${problems}  concluded: date is missing"$'\n'
    [ "$new_journal" -eq 0 ] && problems="${problems}  no new docs/journal/ entry in this commit — the journal must restate the verdict"$'\n'
    if [ -n "$problems" ]; then
      echo "error: pre-commit (conclusion gate): $f flips status to '$new_status' but:" >&2
      printf '%s' "$problems" >&2
      echo "  concluding an experiment = verdict + concluded date + journal entry, one commit." >&2
      echo "  scripts/lenore-docs.py journal writes the entry; then git add it and re-commit." >&2
      fail=1
    fi
  done <<< "$exp_readmes"
fi

# --- (7) Experiment isolation ---------------------------------------------
# Production code must not import from experiments/. The sanctioned path is
# promotion: lift the code into src/ and record it in the experiment README's
# "Lifted into production" section. Narrow, import-shaped patterns only, so
# prose and comments pass.
code_ext='py|swift|js|jsx|ts|tsx|mjs|cjs|rb|go|rs|java|kt|c|cc|cpp|h|hpp|m|mm|sh'
if [ -n "$added$immutable_modified" ] || true; then
  while IFS= read -r -d '' f; do
    case "$f" in experiments/*) continue ;; esac
    printf '%s' "$f" | grep -qE "\.($code_ext)$" || continue
    content=$(git show ":$f" 2>/dev/null) || continue
    hits=$(printf '%s\n' "$content" | grep -nE \
      '^[[:space:]]*(import|from)[[:space:]][^#]*\bexperiments([./[:space:]]|$)|^[[:space:]]*#include[[:space:]]*["<][^">]*experiments/|require\(?[[:space:]]*['"'"'"][^'"'"'"]*experiments/|(import_module|__import__)[[:space:]]*\([[:space:]]*['"'"'"]experiments|^[[:space:]]*(source|\.)[[:space:]]+[^#]*experiments/' \
      | head -3 || true)
    if [ -n "$hits" ]; then
      echo "error: pre-commit (experiment isolation): $f references experiments/ from production code:" >&2
      printf '%s\n' "$hits" | sed 's/^/  /' >&2
      echo "  experiments are quarantined. To use experiment code in production, promote it by" >&2
      echo "  copy into the production tree and record it in experiments/PROMOTIONS.md (and the" >&2
      echo "  experiment README's Recommendations). Experiment-to-experiment reuse is fine." >&2
      fail=1
    fi
  done < <(git diff --cached --name-only -z --diff-filter=AM "$AGAINST" 2>/dev/null || true)
fi

# Symlinks anywhere in the repo may not point into experiments/.
while IFS= read -r -d '' rec; do
  case "$rec" in :*) ;; *) continue ;; esac
  new_mode=$(printf '%s' "$rec" | awk '{print $2}')
  st=$(printf '%s' "$rec" | awk '{print $5}')
  case "$st" in
    R*|C*) IFS= read -r -d '' _src; IFS= read -r -d '' path ;;
    *) IFS= read -r -d '' path ;;
  esac
  [ "$new_mode" = "120000" ] || continue
  target=$(git show ":$path" 2>/dev/null || true)
  # The blessed store symlink (experiments/<exp>/data ->
  # ../../data/experiments/<exp>) points into the store, not into
  # experiments/ — its target merely contains the word. Skip exactly that
  # form here; check (4) already rejected every other shape.
  sl_exp=${path#experiments/}; sl_exp=${sl_exp%/data}
  if [ "$path" = "experiments/$sl_exp/data" ] && [ "$target" = "../../data/experiments/$sl_exp" ]; then
    case "$sl_exp" in */*|"") ;; *) continue ;; esac
  fi
  case "$target" in
    *experiments/*)
      echo "error: pre-commit (experiment isolation): symlink $path -> $target points into experiments/" >&2
      fail=1
      ;;
  esac
done < <(git diff --cached --raw -z -M "$AGAINST" 2>/dev/null || true)

# --- (8) Merge guidance: conflicting dated notes/bugs/notebook entries ------
# Two sessions filing docs/notes|bugs files (or notebook run entries) with
# the same name produce an add/add conflict at merge. Doctrine: both versions
# survive — the merge keeps one under the original name and refiles the other
# under a NEW dated name (for run entries: the next free run id); the
# refiled-from version may then be deleted later like any note.
if [ -n "$MERGE_HEAD_REF" ]; then
  staged_blobs=$(git ls-files -s -- docs/notes docs/bugs 'experiments/*/notebook/*' 'experiments/*/runs/*' 2>/dev/null | awk '{print $2}')
  while IFS=$'\t' read -r path; do
    [ -n "$path" ] || continue
    ours=$(git rev-parse -q --verify "HEAD:$path" 2>/dev/null || true)
    theirs=$(git rev-parse -q --verify "$MERGE_HEAD_REF:$path" 2>/dev/null || true)
    [ -n "$ours" ] && [ -n "$theirs" ] || continue
    [ "$ours" = "$theirs" ] && continue
    missing=""
    printf '%s\n' "$staged_blobs" | grep -q "^$ours$"   || missing="${missing}HEAD:$path "
    printf '%s\n' "$staged_blobs" | grep -q "^$theirs$" || missing="${missing}MERGE_HEAD:$path "
    if [ -n "$missing" ]; then
      # Warn-once: a repeated identical resolution is a deliberate drop
      # (deleting the junk twin IS valid conflict resolution) — only a
      # SILENT drop is blocked, and it costs exactly one retry.
      stampdir="$(git rev-parse --show-toplevel 2>/dev/null || echo .)/.lenore/stamps"
      mkdir -p "$stampdir" 2>/dev/null || true
      merge_ack="$stampdir/merge-ack"
      sig=$(printf '%s %s %s' "$path" "$ours" "$theirs" | git hash-object --stdin 2>/dev/null || echo none)
      if [ -f "$merge_ack" ] && grep -q "^$sig$" "$merge_ack" 2>/dev/null; then
        continue
      fi
      echo "$sig" >> "$merge_ack" 2>/dev/null || true
      echo "error: pre-commit (merge guidance): $path was filed independently on both branches" >&2
      echo "  with different content, and this merge drops a version: $missing" >&2
      echo "  Both are committed history — default is keep both: refile the losing version" >&2
      echo "  under a new dated name (notes) or the next free run id (notebook entries), e.g.:" >&2
      echo "    git show ${missing%% *} > docs/notes/\$(date +%F)-<new-topic-slug>.md && git add docs/notes/" >&2
      echo "  then re-run the merge commit. If you have READ the dropped version and judge it" >&2
      echo "  junk/duplicate, dropping it here is a valid resolution: re-run the same commit" >&2
      echo "  unchanged and it will proceed." >&2
      fail=1
    fi
  done < <(git ls-files -- docs/notes docs/bugs 'experiments/*/notebook/*' 'experiments/*/runs/*' 2>/dev/null)
fi

# --- (11) PROMOTIONS.md is append-only --------------------------------------
# The promotion ledger is provenance: rows are added, never rewritten or
# removed. A modification must keep the previous content as a prefix.
promo=experiments/PROMOTIONS.md
promo_status=$(git diff --cached --name-status "$AGAINST" -- "$promo" 2>/dev/null | awk '{print $1}' | head -1)
case "$promo_status" in
  D)
    echo "error: pre-commit (promotions): $promo may not be deleted — it is the promotion provenance ledger." >&2
    fail=1
    ;;
  M)
    old_promo=$(git show "$AGAINST:$promo" 2>/dev/null || true)
    new_promo=$(git show ":$promo" 2>/dev/null || true)
    case "$new_promo" in
      "$old_promo"*) ;;
      *)
        echo "error: pre-commit (promotions): $promo is append-only — the staged version does not" >&2
        echo "  start with the previous content. Add new rows at the end; never edit or remove old ones." >&2
        fail=1
        ;;
    esac
    ;;
esac

# --- (12) Proposal status field ---------------------------------------------
# Proposals are the ONE revisable dated class (a plan, not a record); the
# front-matter status: is what makes that safe — the status surface and the
# task pointer both key off it. Every staged proposal must carry a valid one.
prop_files=$(git diff --cached --name-only --diff-filter=AM "$AGAINST" -- 'docs/proposals/*.md' 2>/dev/null || true)
if [ -n "$prop_files" ]; then
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    staged=$(git show ":$f" 2>/dev/null) || continue
    pstatus=$(fm_field "$staged" status | tr '[:upper:]' '[:lower:]')
    case "$pstatus" in
      proposed|accepted|deferred|superseded|implemented) ;;
      *)
        echo "error: pre-commit (proposals): $f needs front-matter 'status: proposed|accepted|deferred|superseded|implemented'" >&2
        echo "  (got: '${pstatus:-<missing>}'). Proposals are revisable BECAUSE the status makes their" >&2
        echo "  authority explicit; accepted -> becomes an openspec change; implemented -> conclusions" >&2
        echo "  land in docs/system/ or docs/playbook.md." >&2
        fail=1
        ;;
    esac
  done <<< "$prop_files"
fi

# --- (10) Experiment rename warning (never blocks) -------------------------
# The store dir is keyed by experiment name; renaming experiments/<a>/ to
# experiments/<b>/ strands data/experiments/<a>. Git can't move the
# gitignored store, so just say it once — the orphan check in /doc-cleanup
# is the backstop.
warned_renames=""
while IFS= read -r -d '' status; do
  case "$status" in
    R*)
      IFS= read -r -d '' src
      IFS= read -r -d '' dst
      case "$src" in experiments/*/*) ;; *) continue ;; esac
      case "$dst" in experiments/*/*) ;; *) continue ;; esac
      a=${src#experiments/}; a=${a%%/*}
      b=${dst#experiments/}; b=${b%%/*}
      [ "$a" = "$b" ] && continue
      case " $warned_renames " in *" $a>$b "*) continue ;; esac
      warned_renames="$warned_renames $a>$b"
      if [ -d "data/experiments/$a" ]; then
        echo "note: pre-commit: experiments/$a/ is being renamed to experiments/$b/ —" >&2
        echo "  also move its store dir:  mv data/experiments/$a data/experiments/$b" >&2
        echo "  (and re-point the data symlink). Otherwise the store dir becomes an orphan." >&2
      fi
      ;;
    *)
      IFS= read -r -d '' _f || true
      ;;
  esac
done < <(git diff --cached --name-status -z -M "$AGAINST" 2>/dev/null || true)

# --- (9) Judgment lint at the git layer ----------------------------------
# One lint, two possible homes: agent-harness hook (Claude/Codex — zero
# latency on manual commits) or here in git (manual committers, other
# harnesses, CI). The ok-hash handshake makes them mutually exclusive per
# commit, so both being enabled never double-judges.
commit_lint=$(git config --bool lenore.commitlint 2>/dev/null || echo false)
[ "${LENORE_COMMIT_LINT:-}" = "1" ] && commit_lint=true
[ "${LENORE_COMMIT_LINT:-}" = "0" ] && commit_lint=false
if [ "$fail" -eq 0 ] && [ "$commit_lint" = "true" ] && [ -x scripts/doc-lint.sh ]; then
  if ! scripts/doc-lint.sh --git-hook scripts; then
    fail=1
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "pre-commit rejected. See the doc-system skill (lenore-doc-system) for the rules." >&2
  exit 1
fi

exit 0
