#!/usr/bin/env bash
# Lenore doc system — pre-commit
# Enforces: (1) immutability of docs/journal, docs/notes, experiments/*/runs
#           (2) deny-filename for tracking docs (state.md, decisions.md, ...)
#           (3) prose-only docs/ (additions must be .md/.html/image/.gitkeep)
#           (4) no symlinks/gitlinks under docs/ or experiments/ (except AGENTS.md)
#           (5) shape of new journal/notes/bugs .md files (caps, line-1 summary)
#           (6) experiment conclusion gate: flipping status to concluded/shelved
#               requires a verdict, a concluded date, and a journal entry in the
#               same commit
set -euo pipefail

[ "${SKIP_DOC_HOOKS:-0}" = "1" ] && exit 0

if git rev-parse --verify -q HEAD >/dev/null; then
  AGAINST=HEAD
else
  AGAINST=$(git hash-object -t tree /dev/null)
fi

fail=0

# Parse the staged diff with -z so renames/copies and odd filenames are safe.
# --name-status -z -M: records are NUL-separated; R/C records carry an extra
# similarity/src/dst triple.
immutable_modified=""
immutable_deleted=""
added=""
denied_names='^(state|decisions|status|changelog|handoff(-.+)?|plan(-.+)?|review(-.+)?)\.md$'

is_immutable_path() {
  lc=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  case "$lc" in
    docs/journal/*|docs/notes/*|experiments/*/runs/*.md) return 0 ;;
    *) return 1 ;;
  esac
}

while IFS= read -r -d '' status; do
  case "$status" in
    R*|C*)
      IFS= read -r -d '' src
      IFS= read -r -d '' dst
      if is_immutable_path "$src"; then
        immutable_modified="${immutable_modified}${src} (renamed/copied away)"$'\n'
      fi
      f="$dst"
      # dst is treated like an addition for filename/prose checks below.
      added="${added}${f}"$'\n'
      ;;
    M)
      IFS= read -r -d '' f
      if is_immutable_path "$f"; then
        immutable_modified="${immutable_modified}${f}"$'\n'
      fi
      ;;
    D)
      IFS= read -r -d '' f
      case "$f" in
        docs/journal/*|experiments/*/runs/*.md)
          immutable_deleted="${immutable_deleted}${f}"$'\n'
          ;;
      esac
      ;;
    A)
      IFS= read -r -d '' f
      added="${added}${f}"$'\n'
      ;;
    *)
      # T (typechange) and any other single-path status: consume one path.
      IFS= read -r -d '' f || true
      ;;
  esac
done < <(git diff --cached --name-status -z -M "$AGAINST" 2>/dev/null || true)

# --- (1) Immutability -------------------------------------------------
if [ -n "$immutable_modified" ]; then
  echo "error: pre-commit (immutability): the following files are immutable once committed" >&2
  printf '%s' "$immutable_modified" | sed '/^$/d;s/^/  modified: /' >&2
  echo "  journal entries, notes, and experiment run records may not be edited or renamed after commit." >&2
  echo "  fix typos before the first commit, or write a new dated file instead." >&2
  fail=1
fi

if [ -n "$immutable_deleted" ]; then
  echo "error: pre-commit (immutability): journal entries and run records may not be deleted" >&2
  printf '%s' "$immutable_deleted" | sed '/^$/d;s/^/  deleted: /' >&2
  echo "  these are history and evidence. notes/ may be deleted; these may not." >&2
  fail=1
fi

# --- (2) Deny tracking-doc filenames -----------------------------------
if [ -n "$added" ]; then
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    base=$(basename "$f")
    lower=$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]')
    if printf '%s' "$lower" | grep -qE "$denied_names"; then
      echo "error: pre-commit (deny-filename): $f is a disallowed tracking-doc filename" >&2
      echo "  state.md/decisions.md/STATUS.md/CHANGELOG.md/HANDOFF.md are not part of this" >&2
      echo "  doc system. decisions-as-history -> docs/journal/; decisions-as-current-truth" >&2
      echo "  -> openspec/specs/ or CLAUDE.md; status -> docs/tasks/ + the status line." >&2
      fail=1
    fi
  done <<< "$added"
fi

# --- (3) Prose-only docs/ ------------------------------------------------
if [ -n "$added" ]; then
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    lower_f=$(printf '%s' "$f" | tr '[:upper:]' '[:lower:]')
    case "$lower_f" in
      docs/*)
        base=$(basename "$f")
        if [ "$base" = ".gitkeep" ]; then
          continue
        fi
        ext=$(printf '%s' "$f" | sed -n 's/.*\.\([A-Za-z0-9]*\)$/\1/p' | tr '[:upper:]' '[:lower:]')
        case "$ext" in
          md|html|png|jpg|jpeg|gif|svg|webp) ;;
          *)
            echo "error: pre-commit (prose-only docs/): $f has a disallowed extension for docs/" >&2
            echo "  docs/ holds prose and images only (.md .html .png .jpg .jpeg .gif .svg .webp)." >&2
            echo "  code -> scripts/ or experiments/*/src/ ; outputs -> experiments/*/out/ ;" >&2
            echo "  throwaway -> tmp/ (gitignored)." >&2
            fail=1
            ;;
        esac
        ;;
    esac
  done <<< "$added"
fi

# --- (4) No symlinks/gitlinks under docs/ or experiments/ (except AGENTS.md) --
while IFS= read -r -d '' rec; do
  case "$rec" in
    :*)
      # format: :old_mode new_mode old_sha new_sha status
      new_mode=$(printf '%s' "$rec" | awk '{print $2}')
      status=$(printf '%s' "$rec" | awk '{print $5}')
      ;;
    *)
      continue
      ;;
  esac
  case "$status" in
    R*|C*)
      IFS= read -r -d '' src
      IFS= read -r -d '' dst
      path="$dst"
      ;;
    *)
      IFS= read -r -d '' path
      ;;
  esac
  case "$path" in
    docs/*|experiments/*) ;;
    *) continue ;;
  esac
  if [ "$new_mode" = "120000" ] || [ "$new_mode" = "160000" ]; then
    base=$(basename "$path")
    if [ "$new_mode" = "120000" ] && [ "$base" = "AGENTS.md" ]; then
      continue
    fi
    echo "error: pre-commit (no symlinks/gitlinks): $path (mode $new_mode) may not be added under docs/ or experiments/" >&2
    fail=1
  fi
done < <(git diff --cached --raw -z -M "$AGAINST" 2>/dev/null || true)

# --- (5) Shape of new journal/notes/bugs entries -------------------------
# Checks the STAGED content (git show :path), not the worktree.
if [ -n "$added" ]; then
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    lower_f=$(printf '%s' "$f" | tr '[:upper:]' '[:lower:]')
    case "$lower_f" in
      docs/journal/*.md|docs/notes/*.md|docs/bugs/*.md) ;;
      *) continue ;;
    esac
    content=$(git show ":$f" 2>/dev/null) || continue

    # Line 1 must be a prose summary sentence, not empty and not a heading.
    first=$(printf '%s\n' "$content" | head -1)
    case "$first" in
      "" )
        echo "error: pre-commit (shape): $f — line 1 is empty; it must be a one-sentence summary" >&2
        echo "  (that line is what listings and search results show)." >&2
        fail=1 ;;
      "#"* )
        echo "error: pre-commit (shape): $f — line 1 is a heading; it must be a plain one-sentence summary" >&2
        echo "  (that line is what listings and search results show; drop the leading #)." >&2
        fail=1 ;;
    esac

    # Journal entries additionally: <=10 non-blank lines, <=150 words, no headers/bullets.
    case "$lower_f" in
      docs/journal/*.md)
        nlines=$(printf '%s\n' "$content" | grep -c -v '^[[:space:]]*$' || true)
        nwords=$(printf '%s\n' "$content" | wc -w | tr -d ' ')
        listy=$(printf '%s\n' "$content" | grep -c -E '^[[:space:]]*(#|-[[:space:]]|\*[[:space:]])' || true)
        shape_problems=""
        [ "$nlines" -gt 10 ] && shape_problems="${shape_problems}  ${nlines} non-blank lines (max 10)"$'\n'
        [ "$nwords" -gt 150 ] && shape_problems="${shape_problems}  ${nwords} words (max 150)"$'\n'
        [ "$listy" -gt 0 ] && shape_problems="${shape_problems}  ${listy} heading/bullet line(s) (journal entries are plain prose)"$'\n'
        if [ -n "$shape_problems" ]; then
          echo "error: pre-commit (shape): $f breaks the journal shape rules:" >&2
          printf '%s' "$shape_problems" >&2
          echo "  the journal records the arc, not the detail — trim, or move detail to a" >&2
          echo "  dated note. scripts/lenore-docs.py journal enforces this at write time." >&2
          fail=1
        fi
        ;;
    esac
  done <<< "$added"
fi

# --- (6) Experiment conclusion gate --------------------------------------
# When a commit flips an experiment README's status to concluded/shelved,
# the same commit must carry the verdict, the concluded date, and a journal
# entry restating the outcome — this is exactly the update agents forget.
fm_field() {  # fm_field <content> <key> -> value (front-matter only)
  printf '%s\n' "$1" | sed -n '/^---$/,/^---$/p' | sed -n "s/^$2:[[:space:]]*//p" | head -1
}
exp_readmes=$(git diff --cached --name-only -M "$AGAINST" -- 'experiments/*/README.md' 2>/dev/null || true)
if [ -n "$exp_readmes" ]; then
  new_journal=$(printf '%s' "$added" | grep -c '^docs/journal/.*\.md$' || true)
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    staged=$(git show ":$f" 2>/dev/null) || continue
    new_status=$(fm_field "$staged" status | tr '[:upper:]' '[:lower:]')
    case "$new_status" in concluded|shelved) ;; *) continue ;; esac
    old_content=$(git show "$AGAINST:$f" 2>/dev/null || true)
    old_status=$(fm_field "$old_content" status | tr '[:upper:]' '[:lower:]')
    [ "$old_status" = "$new_status" ] && continue   # not flipped in this commit
    problems=""
    verdict=$(fm_field "$staged" verdict)
    case "$verdict" in
      ""|*"<"*) problems="${problems}  verdict: is empty or still a placeholder — one real sentence stating the outcome"$'\n' ;;
    esac
    concluded=$(fm_field "$staged" concluded)
    [ -z "$concluded" ] && problems="${problems}  concluded: date is missing"$'\n'
    [ "$new_journal" -eq 0 ] && problems="${problems}  no new docs/journal/ entry in this commit — the journal must restate the verdict"$'\n'
    if [ -n "$problems" ]; then
      echo "error: pre-commit (conclusion gate): $f flips status to '$new_status' but:" >&2
      printf '%s' "$problems" >&2
      echo "  concluding an experiment = verdict + concluded date + journal entry, one commit." >&2
      echo "  scripts/lenore-docs.py journal writes the entry; then git add it and re-commit." >&2
      fail=1
    fi
  done <<< "$exp_readmes"
fi

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "pre-commit rejected. See the doc-system skill (lenore-doc-system) for the rules." >&2
  exit 1
fi

exit 0
